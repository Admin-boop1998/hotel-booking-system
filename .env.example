# ── PayPal API ──
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SECRET
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=YOUR_WEBHOOK_ID
PAYPAL_SOFT_DESCRIPTOR=QUOTASOLUTIONS

# ── Application ──
APP_BASE_URL=http://localhost:8100
APP_ENV=development
ALLOWED_ORIGINS=*

# ── SMTP (for real email delivery) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=app-password
# SMTP_FROM=reservations@yourdomain.com

# ── Hero Image (optional — CDN URL for email header image) ──
# HERO_IMAGE_URL=https://yourdomain.com/assets/hotel-hero.jpg

# ── Google Sheets Sync (optional — push bookings to a spreadsheet) ──
# GOOGLE_SHEET_ID=your-google-sheet-id-here
# Also place config/google-credentials.json (service account key)
